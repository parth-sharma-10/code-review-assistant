# Copy to backend/.env:  cp .env.example backend/.env
# The frontend needs no env file for local development (it proxies /api to the backend).

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://cra:cra_dev_password@localhost:5433/code_review_assistant

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- Secrets: generate each with `openssl rand -hex 32` ---
JWT_SECRET=
# 32 bytes as 64 hex chars. Encrypts AI provider API keys at rest (AES-256-GCM).
# Changing it makes previously stored provider keys unreadable.
ENCRYPTION_KEY=

# --- Optional fallback AI provider ---
# Used only when a user has not configured a provider in Settings -> AI Providers.
# Leave OPENAI_BASE_URL empty to disable the fallback.
# OpenAI:    https://api.openai.com/v1
# LM Studio: http://localhost:1234/v1   (API key can be empty)
# Ollama:    http://localhost:11434/v1  (API key can be empty)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
